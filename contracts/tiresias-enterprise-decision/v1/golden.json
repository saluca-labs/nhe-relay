{
  "contract": "tiresias.enterprise.decision/v1",
  "description": "Golden request/response pairs for tiresias.enterprise.decision/v1. Tiresias-ZT replays every case against a live app built from `setup` (tests/test_contract_enterprise_decision_v1.py). A caller (nhe-relay T2.11) can use each `expect` as a stub answer and assert its own behaviour equals `caller_must`: proceed, request_approval or refuse. `expect.body` is a SUBSET: a caller must ignore fields it does not know. The `tiresias_unreachable` case has no answer: the caller must refuse.",
  "setup": {
    "admin_key": "contract-admin-key",
    "registry": {
      "tenants": {
        "acme": {
          "capability_secret": "contract-capability-secret",
          "backend": {"kind": "generic-http", "url": "https://backend.contract.test", "auth": {"type": "none"}},
          "policies": [
            {"methods": ["GET"], "path_prefix": "/v1/memory", "scope": "memory:read"},
            {"methods": ["POST"], "path_prefix": "/v1/memory/search", "scope": "memory:read"},
            {"methods": ["POST", "DELETE"], "path_prefix": "/v1/memory", "scope": "memory:write"}
          ]
        }
      }
    },
    "enterprise_policy": "templates:\n  analyst:\n    intents:\n      \"GET /v1/memory/*\": autonomous\n      \"POST /v1/memory/search\": autonomous\n      \"POST /v1/memory\": supervised\n      \"DELETE /v1/memory/*\": denied\n    tool_grants:\n      - {tool: memory_search, verdict: allow}\n      - {tool: memory_write, verdict: ask}\n      - {tool: http_request, verdict: deny}\n      - {tool: report, verdict: allow, args: {limit: 10}}\nassignments:\n  \"acme/agent-007\": analyst\n"
  },
  "cases": [
    {
      "name": "autonomous_allow",
      "request": {"headers": {"X-Admin-Key": "contract-admin-key"},
                  "body": {"contract": "tiresias.enterprise.decision/v1", "agent": "acme", "acting_as": "agent-007", "method": "GET", "path": "/v1/memory/abc"}},
      "expect": {"status": 200, "body": {"contract": "tiresias.enterprise.decision/v1", "decision": "allow", "route_decision": "allow", "template": "analyst", "autonomy": {"mode": "autonomous"}}},
      "caller_must": "proceed"
    },
    {
      "name": "supervised",
      "request": {"headers": {"X-Admin-Key": "contract-admin-key"},
                  "body": {"agent": "acme", "acting_as": "agent-007", "method": "POST", "path": "/v1/memory"}},
      "expect": {"status": 200, "body": {"decision": "supervised", "autonomy": {"mode": "supervised"}}},
      "caller_must": "request_approval"
    },
    {
      "name": "autonomy_denied",
      "request": {"headers": {"X-Admin-Key": "contract-admin-key"},
                  "body": {"agent": "acme", "acting_as": "agent-007", "method": "DELETE", "path": "/v1/memory/abc"}},
      "expect": {"status": 200, "body": {"decision": "deny", "route_decision": "allow", "autonomy": {"mode": "denied"}}},
      "caller_must": "refuse"
    },
    {
      "name": "omitted_intent_is_denied",
      "request": {"headers": {"X-Admin-Key": "contract-admin-key"},
                  "body": {"agent": "acme", "acting_as": "agent-007", "method": "GET", "path": "/v2/other"}},
      "expect": {"status": 200, "body": {"decision": "deny"}},
      "caller_must": "refuse"
    },
    {
      "name": "unassigned_identity_is_denied",
      "request": {"headers": {"X-Admin-Key": "contract-admin-key"},
                  "body": {"agent": "acme", "acting_as": "agent-999", "method": "GET", "path": "/v1/memory/abc"}},
      "expect": {"status": 200, "body": {"decision": "deny", "template": null, "autonomy": {"mode": "denied"}}},
      "caller_must": "refuse"
    },
    {
      "name": "route_denied",
      "request": {"headers": {"X-Admin-Key": "contract-admin-key"},
                  "body": {"agent": "acme", "acting_as": "agent-007", "method": "PUT", "path": "/v1/unknown"}},
      "expect": {"status": 200, "body": {"decision": "deny", "route_decision": "deny"}},
      "caller_must": "refuse"
    },
    {
      "name": "tool_denied",
      "request": {"headers": {"X-Admin-Key": "contract-admin-key"},
                  "body": {"agent": "acme", "acting_as": "agent-007", "method": "POST", "path": "/v1/memory/search",
                           "tool": {"name": "http_request", "arguments": {"method": "GET", "path": "/"}}}},
      "expect": {"status": 200, "body": {"decision": "deny", "tool_rule": {"verdict": "deny"}}},
      "caller_must": "refuse"
    },
    {
      "name": "tool_unmapped",
      "request": {"headers": {"X-Admin-Key": "contract-admin-key"},
                  "body": {"agent": "acme", "acting_as": "agent-007", "method": "GET", "path": "/v1/memory/abc",
                           "tool": {"name": "shell_exec", "arguments": {}}}},
      "expect": {"status": 200, "body": {"decision": "deny", "tool_rule": {"verdict": "deny"}}},
      "caller_must": "refuse"
    },
    {
      "name": "tool_ask_is_supervised",
      "request": {"headers": {"X-Admin-Key": "contract-admin-key"},
                  "body": {"agent": "acme", "acting_as": "agent-007", "method": "GET", "path": "/v1/memory/abc",
                           "tool": {"name": "memory_write", "arguments": {"content": "x"}}}},
      "expect": {"status": 200, "body": {"decision": "supervised", "tool_rule": {"verdict": "ask"}}},
      "caller_must": "request_approval"
    },
    {
      "name": "tool_typed_argument_match",
      "request": {"headers": {"X-Admin-Key": "contract-admin-key"},
                  "body": {"agent": "acme", "acting_as": "agent-007", "method": "GET", "path": "/v1/memory/abc",
                           "tool": {"name": "report", "arguments": {"limit": 10}}}},
      "expect": {"status": 200, "body": {"decision": "allow", "tool_rule": {"verdict": "allow"}}},
      "caller_must": "proceed"
    },
    {
      "name": "tool_typed_argument_mismatch",
      "request": {"headers": {"X-Admin-Key": "contract-admin-key"},
                  "body": {"agent": "acme", "acting_as": "agent-007", "method": "GET", "path": "/v1/memory/abc",
                           "tool": {"name": "report", "arguments": {"limit": "10"}}}},
      "expect": {"status": 200, "body": {"decision": "deny", "tool_rule": {"verdict": "deny"}}},
      "caller_must": "refuse"
    },
    {
      "name": "unknown_agent",
      "request": {"headers": {"X-Admin-Key": "contract-admin-key"},
                  "body": {"agent": "nobody", "method": "GET", "path": "/v1/memory/abc"}},
      "expect": {"status": 404, "body": {"error": "unknown_agent"}},
      "caller_must": "refuse"
    },
    {
      "name": "bad_admin_key",
      "request": {"headers": {"X-Admin-Key": "wrong"},
                  "body": {"agent": "acme", "method": "GET", "path": "/v1/memory/abc"}},
      "expect": {"status": 403, "body": {"error": "forbidden"}},
      "caller_must": "refuse"
    },
    {
      "name": "bearer_instead_of_admin_key",
      "request": {"headers": {"Authorization": "Bearer contract-admin-key"},
                  "body": {"agent": "acme", "method": "GET", "path": "/v1/memory/abc"}},
      "expect": {"status": 403, "body": {"error": "forbidden"}},
      "caller_must": "refuse"
    },
    {
      "name": "unsupported_contract",
      "request": {"headers": {"X-Admin-Key": "contract-admin-key"},
                  "body": {"contract": "tiresias.enterprise.decision/v2", "agent": "acme", "method": "GET", "path": "/v1/memory/abc"}},
      "expect": {"status": 400, "body": {"error": "unsupported_contract"}},
      "caller_must": "refuse"
    },
    {
      "name": "pre_contract_relay_body",
      "request": {"headers": {"X-Admin-Key": "contract-admin-key"},
                  "body": {"intent": "tool_call", "tool": "memory_search", "employeeId": "e-1", "entityId": "acme"}},
      "expect": {"status": 400, "body": {"error": "unsupported_field"}},
      "caller_must": "refuse"
    },
    {
      "name": "tiresias_unreachable",
      "request": null,
      "expect": {"transport_error": true},
      "caller_must": "refuse"
    }
  ]
}
