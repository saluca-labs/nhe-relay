{
  "contract": "tiresias.enterprise.decision/v2",
  "description": "Golden request/response pairs for tiresias.enterprise.decision/v2. Tiresias-ZT replays every case against a live app built from `setup` (tests/test_contract_enterprise_decision_v2.py), issuing and revoking the credentials through its admin API. A caller (nhe-relay T2.11) can use each `expect` as a stub answer and assert its own behaviour equals `caller_must`: proceed, request_approval or refuse. `expect.body` is a SUBSET: a caller must ignore fields it does not know. `request.endpoint` (default /cp/enterprise/decision) and `request.method` (default POST) name cases that present the relay credential to OTHER endpoints, which must refuse it; those answers are not decision-contract bodies and are not validated against the schema. The `tiresias_unreachable` case has no answer: the caller must refuse.",
  "setup": {
    "admin_key": "contract-admin-key",
    "registry": {
      "tenants": {
        "acme": {
          "capability_secret": "contract-capability-secret",
          "backend": {
            "kind": "generic-http",
            "url": "https://backend.contract.test",
            "auth": {
              "type": "none"
            }
          },
          "policies": [
            {
              "methods": [
                "GET"
              ],
              "path_prefix": "/v1/memory",
              "scope": "memory:read"
            },
            {
              "methods": [
                "POST"
              ],
              "path_prefix": "/v1/memory/search",
              "scope": "memory:read"
            },
            {
              "methods": [
                "POST",
                "DELETE"
              ],
              "path_prefix": "/v1/memory",
              "scope": "memory:write"
            }
          ],
          "customer": "acme-corp"
        },
        "globex-bot": {
          "capability_secret": "contract-capability-secret-globex",
          "backend": {
            "kind": "generic-http",
            "url": "https://globex.contract.test",
            "auth": {
              "type": "none"
            }
          },
          "policies": [
            {
              "methods": [
                "GET"
              ],
              "path_prefix": "/v1/memory",
              "scope": "memory:read"
            },
            {
              "methods": [
                "POST"
              ],
              "path_prefix": "/v1/memory/search",
              "scope": "memory:read"
            },
            {
              "methods": [
                "POST",
                "DELETE"
              ],
              "path_prefix": "/v1/memory",
              "scope": "memory:write"
            }
          ],
          "customer": "globex"
        },
        "orphan": {
          "capability_secret": "contract-capability-secret-orphan",
          "backend": {
            "kind": "generic-http",
            "url": "https://orphan.contract.test",
            "auth": {
              "type": "none"
            }
          },
          "policies": [
            {
              "methods": [
                "GET"
              ],
              "path_prefix": "/v1/memory",
              "scope": "memory:read"
            },
            {
              "methods": [
                "POST"
              ],
              "path_prefix": "/v1/memory/search",
              "scope": "memory:read"
            },
            {
              "methods": [
                "POST",
                "DELETE"
              ],
              "path_prefix": "/v1/memory",
              "scope": "memory:write"
            }
          ]
        }
      }
    },
    "enterprise_policy": "templates:\n  analyst:\n    intents:\n      \"GET /v1/memory/*\": autonomous\n      \"POST /v1/memory/search\": autonomous\n      \"POST /v1/memory\": supervised\n      \"DELETE /v1/memory/*\": denied\n    tool_grants:\n      - {tool: memory_search, verdict: allow}\n      - {tool: memory_write, verdict: ask}\n      - {tool: http_request, verdict: deny}\n      - {tool: report, verdict: allow, args: {limit: 10}}\nassignments:\n  \"acme/agent-007\": analyst\n",
    "credentials": {
      "acme": {
        "tenant": "acme-corp",
        "site": null
      },
      "acme_site1": {
        "tenant": "acme-corp",
        "site": "site-1"
      },
      "globex": {
        "tenant": "globex",
        "site": null
      },
      "acme_revoked": {
        "tenant": "acme-corp",
        "site": null,
        "revoked": true
      },
      "never_issued": {
        "issued": false
      }
    },
    "substitution": "Header values are templates: `{credential:NAME}` is the raw value of the credential NAME, issued through POST /admin/relay-credentials for the named tenant and site (and revoked through DELETE /admin/relay-credentials/{id} when `revoked`); `never_issued` is a fresh, well-formed value Tiresias never issued. `{admin_key}` is setup.admin_key. No credential value is stored in this file."
  },
  "cases": [
    {
      "name": "autonomous_allow",
      "caller_must": "proceed",
      "request": {
        "headers": {
          "Authorization": "Bearer {credential:acme}"
        },
        "body": {
          "contract": "tiresias.enterprise.decision/v2",
          "agent": "acme",
          "acting_as": "agent-007",
          "method": "GET",
          "path": "/v1/memory/abc"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "contract": "tiresias.enterprise.decision/v2",
          "decision": "allow",
          "route_decision": "allow",
          "template": "analyst",
          "autonomy": {
            "mode": "autonomous"
          },
          "tenant": "acme-corp"
        }
      }
    },
